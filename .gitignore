# Ignore hidden files, except for known config files that we want to track.
# This covers most Eclipse, VSCode, etc.  metadata, which is nice.
.*
!.gitleaks.toml
!.dockerignore
!.containerignore
!.gitignore
!.gitattributes
!.basedpyright
!.github
!.terraform-docs.yml
!.python-version
!.opentofu-version
!.mvn

# Un-ignore workspace settings for VSCode
# .vscode is ignored by default via parent .gitignores, so we must unignore the directory
# (due to .gitignore's handling of directory exclusions, see https://git-scm.com/docs/gitignore#_pattern_format)
!/.vscode

# We ignore everything under .vscode, preferring to explicitly unignore certain files
.vscode/**/*
!.vscode/extensions.json
!.vscode/workspace_launch.json
!.vscode/workspace_settings.json

# Ignore everything within top-level dist directory
/dist/**/*

# OSX system files
.DS_Store

# Ignore IntelliJ configuration files
*.iml
*.ipr
*.iws
*.pid

# Ignore Terraform state-related files
*.tfstate
*.tfstate.backup
.terraform.tfstate.lock.info
.terraform/
node_modules/

# Ignore test and generator output written when commands run from the repository root
/out/
/out-test/
__pycache__/
*.pyc

google-java-format.jar
